generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users and Accounts
model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  accounts  Account[]
  sessions  Session[]
}

// UsersRoles
enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Articles
model Article {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  content     String    @db.Text
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  seoTitle        String @default("Article - Progineer")
  seoDescription  String @db.Text @default("Description - Progineer")
  seoKeywords     String[]   // Ex: ["Energie", "DTU", "PACA"]
  seoImage        String?    // Image pour og:image, etc.
}

model Realisation {
  id            String     @id @default(cuid())
  title         String
  description   String     @db.Text
  localisation  String?
  imageUrl      String?
  prestationId  String
  prestation    Prestation @relation(fields: [prestationId], references: [id])
  createdAt     DateTime   @default(now())

  seoTitle        String   @default("Article - Progineer")
  seoDescription  String     @db.Text @default("Description - Progineer")
  seoKeywords     String[]   // Ex: ["rénovation", "construction", "marseille"]
  seoImage        String?    // Image pour og:image, etc.
}


//TODO: ajouter des couleurs, une liste de couleurs qui ne peuvent être utilisés que pour un type de prestation
model Prestation {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  categorie       String     @unique // Ex: "Rénovation", "Construction", "Aménagement intérieur"
  description     String     @db.Text
  imageUrl        String?
  icon            String
  services        String[]
  published       Boolean    @default(false)
  order           Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime?  @updatedAt
  realisations    Realisation[]

  seoTitle        String
  seoDescription  String     @db.Text
  seoKeywords     String[]   // Ex: ["rénovation", "construction", "marseille"]
  seoImage        String?    // Image pour og:image, etc.
}
